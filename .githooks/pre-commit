#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

go_files=()
while IFS= read -r -d '' f; do
	case "$f" in
	*.go) go_files+=("$f") ;;
	esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ ${#go_files[@]} -eq 0 ]; then
	exit 0
fi

gofmt -w "${go_files[@]}"
git add -- "${go_files[@]}"

