diff --git a/TreeDB/internal/dictdb/read_definition_maintenance_test.go b/TreeDB/internal/dictdb/read_definition_maintenance_test.go
new file mode 100644
index 000000000..557f71257
--- /dev/null
+++ b/TreeDB/internal/dictdb/read_definition_maintenance_test.go
@@ -0,0 +1,117 @@
+package dictdb
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"runtime"
+	"testing"
+
+	"github.com/snissn/gomap/TreeDB/db"
+	"github.com/snissn/gomap/TreeDB/internal/valuelog"
+)
+
+func TestCOWMaintenanceDictionaryEarlyCustodyAndUnwind(t *testing.T) {
+	for _, mode := range []string{"refusal", "panic", "goexit", "success"} {
+		for _, stop := range []int{1, 2, 3} {
+			t.Run(mode+string(rune('0'+stop)), func(t *testing.T) {
+				s, err := Open(t.TempDir(), db.Options{ChunkSize: 65536})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer func() {
+					if err := s.Close(); err != nil {
+						t.Error(err)
+					}
+				}()
+				want := bytes.Repeat([]byte("maintenance-definition|"), 128)
+				id, err := s.PutDictBytes(context.Background(), want)
+				if err != nil {
+					t.Fatal(err)
+				}
+				limits := valuelog.COWReadLimits{MaxRecordBytes: 1 << 20, MaxRawBytes: 1 << 20, MaxValueBytes: 1 << 20}
+				refusal := errors.New("selected admission refusal")
+				var owned *DictionaryReadDefinition
+				var result error
+				stage, live, releases := 0, 0, 0
+				unwound, premature := false, false
+				done := make(chan struct{})
+				go func() {
+					defer close(done)
+					defer func() {
+						unwound = recover() != nil
+						premature = releases != 0
+						if err := owned.ClosePreparedRead(); err != nil {
+							result = errors.Join(result, err)
+						}
+					}()
+					result = s.PrepareDictionaryReadDefinitionInto(id, limits, 256, func(DictionaryReadAllocationSizes) (func(), error) {
+						stage++
+						if stage > 1 && owned == nil {
+							panic("owner not transferred before next effect")
+						}
+						if stage == stop {
+							switch mode {
+							case "refusal":
+								return nil, refusal
+							case "panic":
+								panic(refusal)
+							case "goexit":
+								runtime.Goexit()
+							}
+						}
+						live++
+						return func() { live--; releases++ }, nil
+					}, &owned)
+					if result == nil && !bytes.Equal(owned.Bytes, want) {
+						panic("authenticated definition mismatch")
+					}
+				}()
+				<-done // Publishes all scalar/owner observations, including Goexit.
+				if premature || live != 0 {
+					t.Fatalf("cleanup timing/refund: premature=%t live=%d", premature, live)
+				}
+				if mode == "refusal" && !errors.Is(result, refusal) {
+					t.Fatalf("lost original refusal: %v", result)
+				}
+				if mode == "panic" && !unwound {
+					t.Fatal("panic was not propagated to original unwind")
+				}
+				if mode == "success" && result != nil {
+					t.Fatal(result)
+				}
+				if owned != nil {
+					if err := owned.ClosePreparedRead(); err != nil {
+						t.Fatal(err)
+					}
+					if owned.Bytes != nil || owned.snapshot != nil || owned.metadata != nil || owned.pin != nil || owned.releaseOwner != nil || owned.releaseSnapshot != nil || owned.releaseBytes != nil {
+						t.Fatal("refunded before owner aliases were detached")
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestCOWMaintenanceDictionaryRetainsIncompleteCleanup(t *testing.T) {
+	// This negative control supplies a real private snapshot without installing
+	// its required completion receipt. Close acceptance cannot be used as a join.
+	s, err := Open(t.TempDir(), db.Options{ChunkSize: 65536})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := s.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	refunded := false
+	d := &DictionaryReadDefinition{snapshot: s.backend.AcquireStableSnapshot(), releaseOwner: func() { refunded = true }}
+	if d.snapshot == nil {
+		t.Fatal("missing actual snapshot")
+	}
+	first := d.ClosePreparedRead()
+	if first == nil || d.ClosePreparedRead() != first || refunded || d.snapshot == nil || d.releaseOwner == nil {
+		t.Fatal("incomplete original cleanup discarded custody/refunded/retried")
+	}
+}
diff --git a/TreeDB/internal/valuelog/cow_basis_refusal_observer.go b/TreeDB/internal/valuelog/cow_basis_refusal_observer.go
new file mode 100644
index 000000000..1ea65706f
--- /dev/null
+++ b/TreeDB/internal/valuelog/cow_basis_refusal_observer.go
@@ -0,0 +1,225 @@
+package valuelog
+
+import (
+	"sync/atomic"
+
+	"github.com/snissn/gomap/TreeDB/internal/transactionowner"
+)
+
+// COWBasisRefusalObserver is a diagnostic-only, fixture-owned scalar receipt.
+// It retains only a resource-free owner identity, never a DB, snapshot, file,
+// allocator, error, key or body. It is single-owner and must never be reset or
+// reused for another owner. Each scalar is safe to read even after failed Close.
+// Cross-counter snapshots are deliberately not claimed to be atomic cuts.
+type COWBasisRefusalObserver struct {
+	owner     atomic.Pointer[transactionowner.Owner]
+	calls     atomic.Uint64
+	completed atomic.Uint64
+	first     atomic.Uint64
+	overflow  atomic.Bool
+	missing   atomic.Bool
+	entered   [COWBasisStageCount]atomic.Uint64
+	finished  [COWBasisStageCount]atomic.Uint64
+}
+
+type COWBasisStage uint8
+
+const (
+	COWBasisRefresh COWBasisStage = iota
+	COWBasisDescriptor
+	COWBasisPin
+	COWBasisInspect
+	COWBasisDecoderSizes
+	COWBasisAdmission
+	COWBasisDecoder
+	COWBasisLeafRead
+	COWBasisStageCount
+)
+
+type COWBasisDescriptorKind uint8
+
+const (
+	COWBasisNoDescriptor COWBasisDescriptorKind = iota
+	COWBasisNextIncarnation
+	COWBasisMetadata
+	COWBasisIncarnation
+	COWBasisOverlay
+	COWBasisRoot
+)
+
+type COWBasisRefusal uint8
+
+const (
+	COWBasisOtherError COWBasisRefusal = iota + 1
+	COWBasisUnsupported
+	COWBasisCapacity
+	COWBasisCorrupt
+	COWBasisSourceContract
+	COWBasisFrameContract
+	COWBasisPayloadContract
+	COWBasisDictionary
+)
+
+// COWBasisCall is a synchronous, explicit invocation label. Copies contain
+// only scalar labels and the fixture receipt, never borrowed storage authority.
+// The cache's original writer gate serializes Begin calls for the bound owner;
+// no other readers discover or look up a current call.
+type COWBasisCall struct {
+	observer   *COWBasisRefusalObserver
+	ordinal    uint32
+	frozen     bool
+	descriptor COWBasisDescriptorKind
+	after      bool
+	leafRead   bool
+}
+
+// COWBasisRefusalSnapshot.First is one indivisible first-refusal tuple:
+// [0:23] ordinal, [24] frozen, [25:27] descriptor, [28] after,
+// [29:32] stage, [33:36] refusal, [37] shape-known, [38] compressed,
+// [39] dictionary-present, [40:47] codec refer ONLY to successfully inspected
+// shape knowledge. Internal refusal metadata is separate: [48] compression-known,
+// [49] dictionary-presence-known, [50] raw-codec-known; [51] compressed,
+// [52] dictionary-present, [53:60] raw frame Reserved. Internal knowledge never
+// sets shape-known. Zero means NO OBSERVED REFUSAL, not success. Completed/counts
+// are independent diagnostics, not a join proof.
+type COWBasisRefusalSnapshot struct {
+	Calls, Completed, First uint64
+	Overflow, Missing       bool
+	Entered, Finished       [COWBasisStageCount]uint64
+}
+
+func (o *COWBasisRefusalObserver) Bind(owner *transactionowner.Owner) bool {
+	return o != nil && owner != nil && o.owner.CompareAndSwap(nil, owner)
+}
+
+func (o *COWBasisRefusalObserver) Begin(owner *transactionowner.Owner, frozen bool) COWBasisCall {
+	if o == nil || owner == nil || o.owner.Load() != owner || o.overflow.Load() {
+		return COWBasisCall{}
+	}
+	n := o.calls.Add(1)
+	if n > 0xffffff {
+		o.overflow.Store(true)
+		return COWBasisCall{}
+	}
+	c := COWBasisCall{observer: o, ordinal: uint32(n), frozen: frozen}
+	c.Enter(COWBasisRefresh)
+	return c
+}
+
+func (c COWBasisCall) Enabled() bool { return c.observer != nil && c.ordinal != 0 }
+
+func (c COWBasisCall) Descriptor(kind COWBasisDescriptorKind) COWBasisCall {
+	c.descriptor = kind
+	return c
+}
+
+func (c COWBasisCall) Side(after bool) COWBasisCall {
+	c.after = after
+	return c
+}
+
+// LeafRead distinguishes revalidation during the original final read from
+// the earlier inspector; it does not imply that a stage was entered.
+func (c COWBasisCall) LeafRead() COWBasisCall {
+	c.leafRead = true
+	return c
+}
+
+func (c COWBasisCall) Enter(stage COWBasisStage) {
+	if c.Enabled() && stage < COWBasisStageCount {
+		c.observer.entered[stage].Add(1)
+	}
+}
+
+func (c COWBasisCall) Finish(stage COWBasisStage) {
+	if c.Enabled() && stage < COWBasisStageCount {
+		c.observer.finished[stage].Add(1)
+		if stage == COWBasisRefresh {
+			c.observer.completed.Add(1)
+		}
+	}
+}
+
+func (c COWBasisCall) Missing() {
+	if c.Enabled() {
+		c.observer.missing.Store(true)
+	}
+}
+
+func (c COWBasisCall) Refuse(stage COWBasisStage, why COWBasisRefusal, shape COWRecordShape, known bool) {
+	c.refuse(stage, why, shape, known, 0)
+}
+
+// RefuseMetadata captures only scalars already read by the original inspector.
+// Compression is known here. Dictionary presence and RAW Reserved are known
+// only when that original local frame exists; no dictionary ID is retained.
+// These bits describe an internal refusal, never a successfully returned shape.
+func (c COWBasisCall) RefuseMetadata(stage COWBasisStage, why COWBasisRefusal, compressed, dictionaryPresent bool, rawCodec uint8, frameKnown bool) {
+	metadata := uint64(1) << 48
+	if compressed {
+		metadata |= 1 << 51
+	}
+	if frameKnown {
+		metadata |= 1<<49 | 1<<50 | uint64(rawCodec)<<53
+		if dictionaryPresent {
+			metadata |= 1 << 52
+		}
+	}
+	c.refuse(stage, why, COWRecordShape{}, false, metadata)
+}
+
+func (c COWBasisCall) refuse(stage COWBasisStage, why COWBasisRefusal, shape COWRecordShape, known bool, metadata uint64) {
+	if !c.Enabled() || stage >= COWBasisStageCount || why == 0 || why > 15 {
+		return
+	}
+	if c.leafRead && stage == COWBasisInspect {
+		stage = COWBasisLeafRead
+	}
+	word := uint64(c.ordinal) | uint64(c.descriptor)<<25 | uint64(stage)<<29 | uint64(why)<<33 | metadata
+	if c.frozen {
+		word |= 1 << 24
+	}
+	if c.after {
+		word |= 1 << 28
+	}
+	if known {
+		word |= 1 << 37
+		if shape.Compressed {
+			word |= 1 << 38
+		}
+		if shape.DictID != 0 {
+			word |= 1 << 39
+		}
+		word |= uint64(uint8(shape.Codec)) << 40
+	}
+	c.observer.first.CompareAndSwap(0, word)
+}
+
+// Direct comparisons never invoke an arbitrary error's Is/Unwrap/Error methods.
+func (c COWBasisCall) Error(stage COWBasisStage, err error, shape COWRecordShape, known bool) {
+	if !c.Enabled() || err == nil {
+		return
+	}
+	why := COWBasisOtherError
+	switch err {
+	case ErrCOWReadUnsupported:
+		why = COWBasisUnsupported
+	case ErrCOWReadCapacity:
+		why = COWBasisCapacity
+	case ErrCorrupt:
+		why = COWBasisCorrupt
+	}
+	c.Refuse(stage, why, shape, known)
+}
+
+func (o *COWBasisRefusalObserver) Snapshot() COWBasisRefusalSnapshot {
+	if o == nil {
+		return COWBasisRefusalSnapshot{}
+	}
+	s := COWBasisRefusalSnapshot{Calls: o.calls.Load(), Completed: o.completed.Load(), First: o.first.Load(), Overflow: o.overflow.Load(), Missing: o.missing.Load()}
+	for i := range s.Entered {
+		s.Entered[i] = o.entered[i].Load()
+		s.Finished[i] = o.finished[i].Load()
+	}
+	return s
+}
