+
+func (s *cowMaintenanceRefreshControl) PrepareBasisRefreshWithMaintenanceLeaves(before, after *backenddb.Snapshot, leaves backenddb.NativeMaintenanceLeafReader, call valuelog.COWBasisCall) (backenddb.NativeSemanticState, error) {
+	if !leaves.MatchesNativeMaintenanceSnapshots(before, after) {
+		return nil, backenddb.ErrRootPublicationBasisMismatch
+	}
+	for _, snapshot := range []*backenddb.Snapshot{before, after} {
