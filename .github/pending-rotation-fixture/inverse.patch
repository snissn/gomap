-// The caller owns this fresh t.TempDir namespace, with no concurrent actors or
-// DB/journal owner for path. O_EXCL rejects every preexisting path; neither a
-// live stream nor a populated historical segment may be converted here.
-func prepareFreshFixedCleanupActiveForTest(path string, fixedEntry bool) error {
-	reservation, err := os.OpenFile(path, os.O_RDWR|os.O_CREATE|os.O_EXCL, 0o600)
-	if err != nil {
-		return err
-	}
-	info, statErr := reservation.Stat()
-	closeErr := reservation.Close()
-	if statErr != nil || closeErr != nil {
-		return errors.Join(statErr, closeErr)
-	}
-	if !info.Mode().IsRegular() || info.Size() != 0 {
-		return errors.New("cleanup fixture requires an exclusively created zero-length regular file")
-	}
-	linked, err := os.Lstat(path)
-	if err != nil {
-		return err
-	}
-	if !os.SameFile(info, linked) {
-		return errors.New("cleanup fixture fresh path identity changed before writer open")
-	}
-	// Both entry controls own a new, unaccepted writer. Default NewWriter is a
-	// legitimate stream entry; the other control starts explicitly fixed. All
-	// handles are checked-closed BEFORE fixed preparation and actual owner Open.
-	var original *commitlog.Writer
-	if fixedEntry {
-		original, err = commitlog.NewFixedWriterWithCapacity(path, cleanupPressureCapacityForTest)
-	} else {
-		original, err = commitlog.NewWriter(path)
-	}
-	if err != nil {
-		return err
-	}
-	logical := original.ActiveBytes()
-	closeErr = original.Close()
-	if logical != 0 || closeErr != nil {
-		return errors.Join(fmt.Errorf("original fresh writer logical bytes=%d; require zero", logical), closeErr)
-	}
-	frames, err := commitlog.ScanCommandFramesV2(path, commitlog.Options{})
-	if err != nil || len(frames) != 0 {
-		return errors.Join(fmt.Errorf("original fresh writer frames=%d; require zero", len(frames)), err)
-	}
-	fixed, err := commitlog.NewFixedWriterWithCapacity(path, cleanupPressureCapacityForTest)
-	if err != nil {
-		return err
-	}
-	logical = fixed.ActiveBytes()
-	closeErr = fixed.Close()
-	if logical != 0 || closeErr != nil {
-		return errors.Join(fmt.Errorf("prepared fixed writer logical bytes=%d; require zero", logical), closeErr)
-	}
-	frames, err = commitlog.ScanCommandFramesV2(path, commitlog.Options{})
-	if err != nil || len(frames) != 0 {
-		return errors.Join(fmt.Errorf("prepared fixed writer frames=%d; require zero", len(frames)), err)
-	}
-	info, err = os.Lstat(path)
-	if err != nil {
-		return err
-	}
-	if !info.Mode().IsRegular() || info.Size() != cleanupPressureCapacityForTest {
-		return fmt.Errorf("prepared fixed physical size=%d; want %d", info.Size(), cleanupPressureCapacityForTest)
-	}
-	return nil
-}
