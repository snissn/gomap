+			})
+			if reads != 0 || (name == "distinct" && (err != nil || u == nil)) || (name != "distinct" && (err == nil || u != nil)) {
+				t.Fatalf("collision %s: usage=%v err=%v reads=%d", name, u, err, reads)
+			}
+		})
