diff --git a/cmd/unified_bench/process_usage.go b/cmd/unified_bench/process_usage.go
new file mode 100644
index 000000000..7801d024e
--- /dev/null
+++ b/cmd/unified_bench/process_usage.go
@@ -0,0 +1,302 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// Private diagnostic opt-in. It adds no benchmark/gate schema or CLI option.
+const processUsageEnv = "GOMAP_DIAGNOSTIC_STEADY_RUSAGE"
+
+// RUSAGE_SELF covers this process's threads, not its children or pprof samples.
+type processUsageCounters struct {
+	UserCPUNS                  int64 `json:"user_cpu_ns"`
+	SystemCPUNS                int64 `json:"system_cpu_ns"`
+	MinorFaults                int64 `json:"minor_faults"`
+	MajorFaults                int64 `json:"major_faults"`
+	VoluntaryContextSwitches   int64 `json:"voluntary_context_switches"`
+	InvoluntaryContextSwitches int64 `json:"involuntary_context_switches"`
+}
+
+type processUsageSample struct {
+	ReadStartedUnixNS  int64                 `json:"read_started_unix_ns"`
+	ReadFinishedUnixNS int64                 `json:"read_finished_unix_ns"`
+	ReadWallNS         int64                 `json:"read_wall_ns"`
+	ReadFailed         bool                  `json:"read_failed"`
+	Counters           *processUsageCounters `json:"counters"`
+}
+
+type processUsageReceipt struct {
+	Schema              int                    `json:"schema"`
+	Scope               string                 `json:"scope"`
+	Completed           bool                   `json:"completed"`
+	Status              string                 `json:"status"`
+	Attempts            int                    `json:"read_attempts"`
+	Samples             [2]*processUsageSample `json:"samples"`
+	Delta               *processUsageCounters  `json:"delta"`
+	IntervalWallLowerNS *int64                 `json:"interval_wall_lower_ns"`
+	IntervalWallUpperNS *int64                 `json:"interval_wall_upper_ns"`
+}
+
+type steadyProcessUsage struct {
+	path string
+	read func() (processUsageCounters, error)
+
+	receipt         processUsageReceipt
+	failure         error
+	firstReadStart  time.Time
+	firstReadFinish time.Time
+}
+
+func selectedProcessUsage(cfg BenchConfig, dbs, tests []string, supported bool, read func() (processUsageCounters, error)) (*steadyProcessUsage, error) {
+	path := os.Getenv(processUsageEnv)
+	if path == "" {
+		return nil, nil
+	}
+	if !supported {
+		return nil, errors.New("process usage diagnostic is supported only on Linux")
+	}
+	if !filepath.IsAbs(path) || len(dbs) != 1 || len(tests) != 1 || tests[0] != "batch_write_steady" || !shouldCPUProfile(cfg, "batch_write_steady") {
+		return nil, errors.New("process usage diagnostic requires an absolute new receipt path, one DB, only batch_write_steady, and its CPU profile")
+	}
+	if _, err := os.Lstat(path); err == nil || !errors.Is(err, os.ErrNotExist) {
+		return nil, errors.New("process usage receipt must not already exist and its path must be accessible")
+	}
+	if err := validateProcessUsageOutputPath(path, cfg, dbs[0]); err != nil {
+		return nil, err
+	}
+	if read == nil {
+		return nil, errors.New("process usage reader unavailable")
+	}
+	return &steadyProcessUsage{
+		path:    path,
+		read:    read,
+		receipt: processUsageReceipt{Schema: 1, Scope: "WORK_INTERVAL", Status: "INCOMPLETE"},
+	}, nil
+}
+
+func (c processUsageCounters) valid() bool {
+	return c.UserCPUNS >= 0 && c.SystemCPUNS >= 0 && c.MinorFaults >= 0 && c.MajorFaults >= 0 && c.VoluntaryContextSwitches >= 0 && c.InvoluntaryContextSwitches >= 0
+}
+
+func processUsageDelta(a, b processUsageCounters) (processUsageCounters, error) {
+	if !a.valid() || !b.valid() || b.UserCPUNS < a.UserCPUNS || b.SystemCPUNS < a.SystemCPUNS || b.MinorFaults < a.MinorFaults || b.MajorFaults < a.MajorFaults || b.VoluntaryContextSwitches < a.VoluntaryContextSwitches || b.InvoluntaryContextSwitches < a.InvoluntaryContextSwitches {
+		return processUsageCounters{}, errors.New("invalid or regressing process usage counters")
+	}
+	return processUsageCounters{
+		UserCPUNS:                  b.UserCPUNS - a.UserCPUNS,
+		SystemCPUNS:                b.SystemCPUNS - a.SystemCPUNS,
+		MinorFaults:                b.MinorFaults - a.MinorFaults,
+		MajorFaults:                b.MajorFaults - a.MajorFaults,
+		VoluntaryContextSwitches:   b.VoluntaryContextSwitches - a.VoluntaryContextSwitches,
+		InvoluntaryContextSwitches: b.InvoluntaryContextSwitches - a.InvoluntaryContextSwitches,
+	}, nil
+}
+
+func (u *steadyProcessUsage) sample() error {
+	if u.failure != nil {
+		return u.failure
+	}
+	if u.receipt.Attempts >= len(u.receipt.Samples) {
+		u.failure = errors.New("process usage diagnostic permits at most two reads")
+		return u.failure
+	}
+	i := u.receipt.Attempts
+	u.receipt.Attempts++
+	before := time.Now()
+	counters, err := u.read()
+	after := time.Now()
+	s := &processUsageSample{ReadStartedUnixNS: before.UnixNano(), ReadFinishedUnixNS: after.UnixNano(), ReadWallNS: after.Sub(before).Nanoseconds()}
+	u.receipt.Samples[i] = s
+	if i == 0 {
+		u.firstReadStart, u.firstReadFinish = before, after
+	}
+	if err != nil {
+		s.ReadFailed = true
+		u.failure = fmt.Errorf("process usage read %d: %w", i+1, err)
+		return u.failure
+	}
+	s.Counters = &counters
+	if !counters.valid() || s.ReadWallNS < 0 || s.ReadFinishedUnixNS < s.ReadStartedUnixNS || (i == 1 && s.ReadStartedUnixNS < u.receipt.Samples[0].ReadFinishedUnixNS) {
+		u.failure = errors.New("invalid process usage counters or wall bounds")
+		return u.failure
+	}
+	if i == 1 {
+		lower := before.Sub(u.firstReadFinish).Nanoseconds()
+		upper := after.Sub(u.firstReadStart).Nanoseconds()
+		if lower < 0 || upper < lower {
+			u.failure = errors.New("invalid process usage interval wall bounds")
+			return u.failure
+		}
+		u.receipt.IntervalWallLowerNS, u.receipt.IntervalWallUpperNS = &lower, &upper
+		delta, deltaErr := processUsageDelta(*u.receipt.Samples[0].Counters, counters)
+		if deltaErr != nil {
+			u.failure = deltaErr
+			return u.failure
+		}
+		u.receipt.Delta = &delta
+	}
+	return nil
+}
+
+// Called after finishCPUProfile. The original operation/checkpoint error wins.
+func (u *steadyProcessUsage) finish(workErr error) error {
+	u.receipt.Completed = false
+	u.receipt.Status = "INCOMPLETE"
+	if workErr != nil {
+		u.receipt.Status = "ORIGINAL_WORK_OR_DIAGNOSTIC_FAILED"
+		u.receipt.Delta = nil
+		return workErr
+	}
+	if u.failure != nil {
+		u.receipt.Delta = nil
+		return u.failure
+	}
+	if u.receipt.Attempts != 2 || u.receipt.Samples[0] == nil || u.receipt.Samples[1] == nil || u.receipt.Delta == nil {
+		return errors.New("incomplete process usage diagnostic")
+	}
+	u.receipt.Completed = true
+	u.receipt.Status = "COMPLETE_WORK_INTERVAL_DIAGNOSTIC_ONLY"
+	return nil
+}
+
+func writeProcessUsageReceipt(path string, receipt *processUsageReceipt) error {
+	data, err := json.Marshal(receipt)
+	if err != nil {
+		return err
+	}
+	if len(data) > 4096 {
+		return errors.New("process usage receipt exceeds fixed 4096-byte bound")
+	}
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return err
+	}
+	_, writeErr := f.Write(data)
+	closeErr := f.Close()
+	if writeErr != nil || closeErr != nil {
+		return errors.Join(writeErr, closeErr, os.Remove(path))
+	}
+	return nil
+}
+
+// Resolve existing parent aliases without creating any output. Later profile
+// directories may not exist yet, so resolve their nearest existing ancestor.
+func processUsageCanonicalPath(path string) (string, error) {
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	var tail []string
+	for current := filepath.Clean(absolute); ; current = filepath.Dir(current) {
+		resolved, err := filepath.EvalSymlinks(current)
+		if err == nil {
+			for i := len(tail) - 1; i >= 0; i-- {
+				resolved = filepath.Join(resolved, tail[i])
+			}
+			return resolved, nil
+		}
+		if !errors.Is(err, os.ErrNotExist) || filepath.Dir(current) == current {
+			return "", err
+		}
+		tail = append(tail, filepath.Base(current))
+	}
+}
+
+func validateProcessUsageOutputPath(path string, cfg BenchConfig, dbName string) error {
+	parent, err := os.Stat(filepath.Dir(path))
+	if err != nil || !parent.IsDir() {
+		return errors.New("process usage receipt requires an existing parent directory")
+	}
+	receipt, err := processUsageCanonicalPath(path)
+	if err != nil {
+		return fmt.Errorf("process usage receipt path: %w", err)
+	}
+	const testName = "batch_write_steady"
+	paths := []string{cfg.BlockProfile, cfg.MutexProfile, cfg.TraceProfile}
+	if shouldCPUProfile(cfg, testName) {
+		paths = append(paths, strings.TrimSpace(cfg.CPUProfile)+"_"+testName+"_"+dbName+".pprof")
+	}
+	if shouldAllocsProfile(cfg, testName) {
+		paths = append(paths, strings.TrimSpace(cfg.AllocsProfile)+"_"+testName+"_"+dbName+".pprof")
+	}
+	for _, pair := range [][2]string{{cfg.BlockProfile, "block"}, {cfg.MutexProfile, "mutex"}} {
+		if strings.TrimSpace(pair[0]) != "" {
+			paths = append(paths, contentionProfilePath(pair[0], pair[1], testName, dbName))
+		}
+	}
+	// Checkpoint profiles use the wrapper's runtime Name. Reserve the configured
+	// checkpoint namespace before opening it; do not guess that Name from dbName.
+	if prefix := strings.TrimSpace(cfg.CheckpointCPUProfile); prefix != "" {
+		canonical, err := processUsageCanonicalPath(prefix)
+		if err != nil {
+			return err
+		}
+		if (strings.HasPrefix(receipt, canonical+"_checkpoint_") && strings.HasSuffix(receipt, ".pprof")) || strings.HasPrefix(canonical, receipt+string(filepath.Separator)) {
+			return errors.New("process usage receipt collides with checkpoint profile namespace")
+		}
+	}
+	if dir := strings.TrimSpace(*profileDir); dir != "" {
+		for _, name := range []string{"benchprof_results.json", "benchprof_results.md", "insights.json", "insights.md", "insights.html"} {
+			paths = append(paths, filepath.Join(dir, name))
+		}
+	}
+	for _, output := range paths {
+		if strings.TrimSpace(output) == "" {
+			continue
+		}
+		canonical, err := processUsageCanonicalPath(output)
+		if err != nil {
+			return fmt.Errorf("process usage output path: %w", err)
+		}
+		if receipt == canonical || strings.HasPrefix(canonical, receipt+string(filepath.Separator)) {
+			return fmt.Errorf("process usage receipt collides with benchmark output %s", output)
+		}
+	}
+	return nil
+}
+
+// Selected-mode ownership only. A failed original Close is never retried and
+// its directory is retained because release of the DB's resources is unproved.
+type processUsageDBOwner struct {
+	instance        *DBInstance
+	closeAttempted  bool
+	closeOK         bool
+	removeAttempted bool
+}
+
+func (o *processUsageDBOwner) close() error {
+	if o.closeAttempted {
+		return nil
+	}
+	o.closeAttempted = true
+	if err := o.instance.Wrapper.Close(); err != nil {
+		return fmt.Errorf("close %s: %w", o.instance.Name, err)
+	}
+	o.closeOK = true
+	return nil
+}
+
+func (o *processUsageDBOwner) removeDir() error {
+	if !o.closeOK || o.removeAttempted {
+		return nil
+	}
+	o.removeAttempted = true
+	if err := os.RemoveAll(o.instance.Dir); err != nil {
+		return fmt.Errorf("remove %s directory: %w", o.instance.Name, err)
+	}
+	return nil
+}
+
+func (o *processUsageDBOwner) cleanup(keepDir bool) error {
+	closeErr := o.close()
+	if keepDir {
+		return closeErr
+	}
+	return errors.Join(closeErr, o.removeDir())
+}
diff --git a/cmd/unified_bench/process_usage_linux.go b/cmd/unified_bench/process_usage_linux.go
new file mode 100644
index 000000000..c2d3b9da2
--- /dev/null
+++ b/cmd/unified_bench/process_usage_linux.go
@@ -0,0 +1,45 @@
+//go:build linux
+
+package main
+
+import (
+	"errors"
+	"math"
+	"syscall"
+)
+
+const processUsageSupported = true
+
+func processUsageTimevalNS(sec, usec int64) (int64, error) {
+	if sec < 0 || usec < 0 || usec >= 1000000 || sec > (math.MaxInt64-usec*1000)/1000000000 {
+		return 0, errors.New("invalid or overflowing rusage timeval")
+	}
+	return sec*1000000000 + usec*1000, nil
+}
+
+func readProcessUsage() (processUsageCounters, error) {
+	var r syscall.Rusage
+	if err := syscall.Getrusage(syscall.RUSAGE_SELF, &r); err != nil {
+		return processUsageCounters{}, err
+	}
+	user, err := processUsageTimevalNS(int64(r.Utime.Sec), int64(r.Utime.Usec))
+	if err != nil {
+		return processUsageCounters{}, err
+	}
+	system, err := processUsageTimevalNS(int64(r.Stime.Sec), int64(r.Stime.Usec))
+	if err != nil {
+		return processUsageCounters{}, err
+	}
+	counters := processUsageCounters{
+		UserCPUNS:                  user,
+		SystemCPUNS:                system,
+		MinorFaults:                int64(r.Minflt),
+		MajorFaults:                int64(r.Majflt),
+		VoluntaryContextSwitches:   int64(r.Nvcsw),
+		InvoluntaryContextSwitches: int64(r.Nivcsw),
+	}
+	if !counters.valid() {
+		return processUsageCounters{}, errors.New("negative rusage counter")
+	}
+	return counters, nil
+}
diff --git a/cmd/unified_bench/process_usage_linux_test.go b/cmd/unified_bench/process_usage_linux_test.go
new file mode 100644
index 000000000..80d306fb5
--- /dev/null
+++ b/cmd/unified_bench/process_usage_linux_test.go
@@ -0,0 +1,312 @@
+//go:build linux
+
+package main
+
+import (
+	"errors"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/snissn/gomap/kvstore"
+)
+
+type processUsageCheckpointDB struct {
+	*batchDeleteRangeMemoryDB
+	checkpointErr error
+	closeErr      error
+}
+
+func (d *processUsageCheckpointDB) Checkpoint() error {
+	*d.events = append(*d.events, "checkpoint")
+	return d.checkpointErr
+}
+
+func (d *processUsageCheckpointDB) Close() error {
+	*d.events = append(*d.events, "db_close")
+	return errors.Join(d.batchDeleteRangeMemoryDB.Close(), d.closeErr)
+}
+
+func runProcessUsageFixture(t *testing.T, selected bool, failRead int, checkpointErr, writeErr, closeErr error, keepDir ...bool) ([]string, *processUsageReceipt, int, error) {
+	t.Helper()
+	var events []string
+	var receipt *processUsageReceipt
+	reads := 0
+	var openedDir string
+	keep := len(keepDir) == 1 && keepDir[0]
+	t.Setenv("TMPDIR", t.TempDir())
+	name := "process_usage_" + strings.ToLower(strings.ReplaceAll(t.Name(), "/", "_"))
+	RegisterHiddenDB(name, func(dir string) (kvstore.DB, error) {
+		openedDir = dir
+		d := newBatchDeleteRangeMemoryDB(name)
+		d.events = &events
+		return &processUsageCheckpointDB{batchDeleteRangeMemoryDB: d, checkpointErr: checkpointErr, closeErr: closeErr}, nil
+	})
+	path := ""
+	if selected {
+		path = filepath.Join(t.TempDir(), "usage.json")
+	}
+	t.Setenv(processUsageEnv, path)
+	hooks := &benchmarkProfileHooks{
+		startCPUProfile: func(io.Writer) error {
+			events = append(events, "cpu_start")
+			return nil
+		},
+		stopCPUProfile: func() {
+			events = append(events, "cpu_stop")
+		},
+		readProcessUsage: func() (processUsageCounters, error) {
+			reads++
+			events = append(events, "usage_read")
+			if reads == failRead {
+				return processUsageCounters{}, errProcessUsageFixtureRead
+			}
+			return processUsageCounters{UserCPUNS: int64(reads), SystemCPUNS: int64(reads)}, nil
+		},
+		writeProcessUsage: func(_ string, r *processUsageReceipt) error {
+			events = append(events, "usage_write")
+			copy := *r
+			receipt = &copy
+			return writeErr
+		},
+	}
+	_, err := runBenchmark(BenchConfig{Keys: 64, ValueSize: 8, BatchSize: 16, DBsArg: name, TestsArg: "batch_write_steady", SeedUsed: 1, KeepDir: keep, CPUProfile: filepath.Join(t.TempDir(), "cpu"), profileHooks: hooks})
+	if selected {
+		closes := 0
+		for _, event := range events {
+			if event == "db_close" {
+				closes++
+			}
+		}
+		if closes != 1 {
+			t.Fatalf("selected mode must attempt original Close once: %v", events)
+		}
+		_, statErr := os.Stat(openedDir)
+		if keep || closeErr != nil {
+			if statErr != nil {
+				t.Fatalf("kept or failed-Close directory must remain: %v", statErr)
+			}
+		} else if !errors.Is(statErr, os.ErrNotExist) {
+			t.Fatalf("successfully closed directory leaked: %s: %v", openedDir, statErr)
+		}
+	}
+	return events, receipt, reads, err
+}
+
+var errProcessUsageFixtureRead = errors.New("injected usage reader error")
+
+func TestRunBenchmarkProcessUsageDefaultZero(t *testing.T) {
+	events, receipt, reads, err := runProcessUsageFixture(t, false, 1, nil, nil, nil)
+	if err != nil || reads != 0 || receipt != nil {
+		t.Fatalf("default reads=%d receipt=%+v err=%v", reads, receipt, err)
+	}
+	if len(events) == 0 {
+		t.Fatal("original work did not run")
+	}
+}
+
+func TestRunBenchmarkProcessUsageTwoReadsCheckpointOrder(t *testing.T) {
+	events, receipt, reads, err := runProcessUsageFixture(t, true, 0, nil, nil, nil)
+	if err != nil || reads != 2 || receipt == nil || !receipt.Completed || receipt.Delta == nil || receipt.Delta.UserCPUNS != 1 || receipt.IntervalWallLowerNS == nil || receipt.IntervalWallUpperNS == nil || *receipt.IntervalWallUpperNS < *receipt.IntervalWallLowerNS {
+		t.Fatalf("reads=%d receipt=%+v err=%v", reads, receipt, err)
+	}
+	var selected []string
+	sets := 0
+	for _, event := range events {
+		if event == "set" {
+			sets++
+			continue
+		}
+		selected = append(selected, event)
+		if event == "usage_write" {
+			break // Original post-run maintenance is outside this receipt.
+		}
+	}
+	want := []string{"cpu_start", "usage_read", "checkpoint", "usage_read", "cpu_stop", "usage_write"}
+	if sets != 64 || !reflect.DeepEqual(selected, want) {
+		t.Fatalf("original sets=%d order=%v, want=%v", sets, selected, want)
+	}
+	for _, sample := range receipt.Samples {
+		if sample == nil || sample.Counters == nil || sample.ReadFailed || sample.ReadWallNS < 0 || sample.ReadFinishedUnixNS < sample.ReadStartedUnixNS {
+			t.Fatalf("unbounded/missing successful read: %+v", sample)
+		}
+	}
+}
+
+func TestRunBenchmarkProcessUsageOriginalFailureWins(t *testing.T) {
+	original := errors.New("original final checkpoint failure")
+	writeFailure := errors.New("secondary receipt write failure")
+	closeFailure := errors.New("secondary receipt close failure")
+	removeFailure := errors.New("secondary receipt remove failure")
+	writer := errors.Join(writeFailure, closeFailure, removeFailure)
+	events, receipt, reads, err := runProcessUsageFixture(t, true, 0, original, writer, nil)
+	if !errors.Is(err, original) || !errors.Is(err, writer) || reads != 1 || receipt == nil || receipt.Completed || receipt.Delta != nil || receipt.Samples[1] != nil {
+		t.Fatalf("reads=%d receipt=%+v err=%v", reads, receipt, err)
+	}
+	// This tests propagation of cleanup errors from the existing hook, not OS failure injection.
+	for _, secondary := range []error{writeFailure, closeFailure, removeFailure} {
+		if !errors.Is(err, secondary) || strings.Index(err.Error(), original.Error()) >= strings.Index(err.Error(), secondary.Error()) {
+			t.Fatalf("original error must be first and each secondary retained: %v", err)
+		}
+	}
+	var stop, write int
+	for i, event := range events {
+		if event == "cpu_stop" {
+			stop = i
+		}
+		if event == "usage_write" {
+			write = i
+		}
+	}
+	if stop == 0 || write <= stop {
+		t.Fatalf("original CPU stop/write order=%v", events)
+	}
+}
+
+func TestRunBenchmarkProcessUsageReaderError(t *testing.T) {
+	for _, attempt := range []int{1, 2} {
+		name := "first"
+		if attempt == 2 {
+			name = "second"
+		}
+		t.Run(name, func(t *testing.T) {
+			events, receipt, reads, err := runProcessUsageFixture(t, true, attempt, nil, nil, nil)
+			if !errors.Is(err, errProcessUsageFixtureRead) || reads != attempt || receipt == nil || receipt.Completed || receipt.Delta != nil || !receipt.Samples[attempt-1].ReadFailed || receipt.Samples[attempt-1].Counters != nil {
+				t.Fatalf("reads=%d receipt=%+v err=%v", reads, receipt, err)
+			}
+			stops, sets, checkpoints := 0, 0, 0
+			for _, event := range events {
+				if event == "cpu_stop" {
+					stops++
+				}
+				if event == "set" {
+					sets++
+				}
+				if event == "checkpoint" {
+					checkpoints++
+				}
+			}
+			if stops != 1 || (attempt == 1 && sets != 0) || (attempt == 2 && (sets != 64 || checkpoints != 1)) {
+				t.Fatalf("read failure changed original order: %v", events)
+			}
+		})
+	}
+}
+
+func TestProcessUsageTimevalBounds(t *testing.T) {
+	if got, err := processUsageTimevalNS(1, 2); err != nil || got != 1000002000 {
+		t.Fatalf("timeval=(%d,%v)", got, err)
+	}
+	for _, pair := range [][2]int64{{-1, 0}, {0, -1}, {0, 1000000}, {math.MaxInt64, 0}} {
+		if _, err := processUsageTimevalNS(pair[0], pair[1]); err == nil {
+			t.Fatalf("invalid timeval accepted: %v", pair)
+		}
+	}
+}
+
+func TestRunBenchmarkProcessUsageCloseFailureIsNotLifecycleSuccess(t *testing.T) {
+	originalClose := errors.New("original DB Close failure")
+	events, receipt, reads, err := runProcessUsageFixture(t, true, 0, nil, nil, originalClose)
+	if !errors.Is(err, originalClose) || reads != 2 || receipt == nil || !receipt.Completed || receipt.Scope != "WORK_INTERVAL" || receipt.Status != "COMPLETE_WORK_INTERVAL_DIAGNOSTIC_ONLY" || receipt.Delta == nil {
+		t.Fatalf("interval completion must coexist with failed original Close: reads=%d receipt=%+v err=%v", reads, receipt, err)
+	}
+	writeAt, closeAt := -1, -1
+	for i, event := range events {
+		if event == "usage_write" {
+			writeAt = i
+		}
+		if event == "db_close" {
+			closeAt = i
+		}
+	}
+	if writeAt < 0 || closeAt <= writeAt {
+		t.Fatalf("receipt must not move or certify original DB Close: %v", events)
+	}
+}
+
+func TestRunBenchmarkProcessUsageCleanup(t *testing.T) {
+	for _, name := range []string{"write_failure", "write_and_close_failure", "read_and_close_failure", "keep_dir", "normal"} {
+		t.Run(name, func(t *testing.T) {
+			var writeErr, closeErr error
+			if name == "write_failure" || name == "write_and_close_failure" {
+				writeErr = errors.New("receipt write failure")
+			}
+			if name == "write_and_close_failure" || name == "read_and_close_failure" {
+				closeErr = errors.New("DB Close failure")
+			}
+			failRead := 0
+			primary := writeErr
+			if name == "read_and_close_failure" {
+				failRead = 1
+				primary = errProcessUsageFixtureRead
+			}
+			_, receipt, reads, err := runProcessUsageFixture(t, true, failRead, nil, writeErr, closeErr, name == "keep_dir")
+			if receipt == nil || (failRead == 0 && (!receipt.Completed || reads != 2)) || (failRead != 0 && (receipt.Completed || reads != 1)) {
+				t.Fatalf("unexpected interval: reads=%d receipt=%+v", reads, receipt)
+			}
+			if writeErr == nil && closeErr == nil && err != nil {
+				t.Fatal(err)
+			}
+			if primary != nil && !errors.Is(err, primary) {
+				t.Fatalf("lost original diagnostic failure: %v", err)
+			}
+			if closeErr != nil && (!errors.Is(err, closeErr) || strings.Index(err.Error(), primary.Error()) >= strings.Index(err.Error(), closeErr.Error())) {
+				t.Fatalf("original error must precede cleanup Close failure: %v", err)
+			}
+		})
+	}
+}
+
+func TestProcessUsageCleanupRemoveFailure(t *testing.T) {
+	var events []string
+	db := newBatchDeleteRangeMemoryDB("usage_remove")
+	db.events = &events
+	owner := &processUsageDBOwner{instance: &DBInstance{Name: "usage_remove", Wrapper: &processUsageCheckpointDB{batchDeleteRangeMemoryDB: db}, Dir: "\x00"}}
+	if err := owner.cleanup(false); err == nil || !owner.closeOK || !owner.removeAttempted {
+		t.Fatalf("actual invalid-path RemoveAll error lost: %v", err)
+	}
+	if err := owner.cleanup(false); err != nil {
+		t.Fatalf("cleanup operation was retried: %v", err)
+	}
+	closes := 0
+	for _, event := range events {
+		if event == "db_close" {
+			closes++
+		}
+	}
+	if closes != 1 {
+		t.Fatalf("Close attempts=%d", closes)
+	}
+}
+
+func TestRunBenchmarkProcessUsageCollisionBeforeOpen(t *testing.T) {
+	name := "usage_collision_before_open"
+	opens := 0
+	RegisterHiddenDB(name, func(string) (kvstore.DB, error) {
+		opens++
+		return nil, errors.New("factory must not be entered")
+	})
+	prefix := filepath.Join(t.TempDir(), "cpu")
+	t.Setenv(processUsageEnv, prefix+"_batch_write_steady_"+name+".pprof")
+	_, err := runBenchmark(BenchConfig{Keys: 64, ValueSize: 8, BatchSize: 16, DBsArg: name, TestsArg: "batch_write_steady", CPUProfile: prefix})
+	if err == nil || opens != 0 {
+		t.Fatalf("collision reached factory: opens=%d err=%v", opens, err)
+	}
+}
+
+func TestProcessUsageOutputAlias(t *testing.T) {
+	dir := t.TempDir()
+	alias := filepath.Join(t.TempDir(), "alias")
+	if err := os.Symlink(dir, alias); err != nil {
+		t.Fatal(err)
+	}
+	cfg := BenchConfig{CPUProfile: filepath.Join(alias, "cpu")}
+	t.Setenv(processUsageEnv, filepath.Join(dir, "cpu_batch_write_steady_one.pprof"))
+	if u, err := selectedProcessUsage(cfg, []string{"one"}, []string{"batch_write_steady"}, true, func() (processUsageCounters, error) { return processUsageCounters{}, nil }); err == nil || u != nil {
+		t.Fatalf("aliased future output accepted: %v %v", u, err)
+	}
+}
