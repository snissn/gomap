    "/home/mikers/dev/codex-r1-5090-functional-linux111-20261008/source/M23-phase2-v11/TreeDB/internal/valuelog/fuzz_decode_test.go": {
      "sha256": "22cca4651619d33e112e25fe407c96e7f920e9da5a0d0888a10006b4499cc81c",
      "text": "package valuelog\n\nimport \"testing\"\n\nfunc FuzzDecodeFrame(f *testing.F) {\n\traw, _, err := EncodeFrame(0, nil, []Record{{RID: 1, Value: []byte(\"hello world\")}})\n\tif err == nil && len(raw) > 0 {\n\t\tf.Add(raw)\n\t\tif len(raw) > 4 {\n\t\t\tf.Add(raw[:len(raw)/2])\n\t\t}\n\t}\n\tf.Add([]byte{0x00})\n\tf.Add([]byte{0xff, 0xff, 0xff, 0xff})\n\tf.Add([]byte{0x01, 0x02, 0x03, 0x04, 0x05})\n\n\tf.Fuzz(func(t *testing.T, data []byte) {\n\t\t_, _, _, _, _ = DecodeFrame(data)\n\t})\n}\n"
    },
