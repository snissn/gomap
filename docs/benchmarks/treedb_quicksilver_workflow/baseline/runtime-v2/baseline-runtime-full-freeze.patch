+#!/usr/bin/env python3
+"""Bounded source-guard checks, plus optional prepared-input drift check."""
+import argparse
+import copy
+import json
+from pathlib import Path
+import sys
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / "scripts"))
+import treedb_memory_budget_capture as memory
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--source-root", type=Path, required=True)
+parser.add_argument("--manifest", type=Path, required=True)
+parser.add_argument("--manifest-sha256", required=True)
+parser.add_argument("--prepared", type=Path)
+parser.add_argument("--freeze-sha256")
+args = parser.parse_args()
+root, manifest_path = args.source_root.resolve(), args.manifest.resolve()
+memory.check_baseline_sources(root, manifest_path, args.manifest_sha256)
+real_git = memory.git
+
+
+def rejects(call, message):
+    try:
+        call()
+    except ValueError as error:
+        assert message in str(error), (message, str(error))
+    else:
+        raise AssertionError("accepted " + message)
+
+
+for target, changed, message in (
+    (("diff", "--name-only", "HEAD", "--"), "TreeDB/public.go", "dirty tracked baseline source"),
+    (("ls-files", "--others", "--exclude-standard", "-z"),
+        real_git(root, "ls-files", "--others", "--exclude-standard", "-z") + "\0unallowed.go\0", "unallowed/missing baseline additions"),
+    (("ls-files", "--others", "--ignored", "--exclude-standard", "-z"), "tmp/ignored.go\0", "unallowed ignored source input"),
+    (("rev-parse", "HEAD"), "wrong", "wrong baseline product runtime_head"),
+):
+    def git(source, *command):
+        return changed if command == target else real_git(source, *command)
+    with patch.object(memory, "git", git):
+        rejects(lambda: memory.check_baseline_sources(root, manifest_path, args.manifest_sha256), message)
+rejects(lambda: memory.check_baseline_sources(root, manifest_path, "wrong"), "wrong/changed external baseline manifest")
+fixture = Path(__file__).resolve().parent / "full-freeze-selfcheck-fixture"
+fixture.mkdir(exist_ok=True)
+manifest = copy.deepcopy(json.loads(manifest_path.read_text()))
+replacement = fixture / "changed-replacement.go"
+replacement.write_text("package changed\n")
+manifest["external_inputs"]["TreeDB/quicksilver_workflow_bench_test.go"]["path"] = str(replacement)
+changed_manifest = fixture / "changed-input-manifest.json"
+memory.write_json(changed_manifest, manifest)
+rejects(lambda: memory.check_baseline_sources(root, changed_manifest, memory.digest(changed_manifest)), "changed baseline replacement/toolchain input")
+if args.prepared:
+    assert args.freeze_sha256
+    prepared = args.prepared.resolve()
+    freeze = memory.load_freeze(prepared, args.freeze_sha256)
+    assert freeze["pilot"] is False and freeze["environment"]["TREEDB_MEMORY_PILOT"] == "0"
+    tracked = root / "TreeDB/public.go"
+    original = tracked.read_bytes()
+    try:
+        tracked.write_bytes(original + b"\n// deliberate source-guard test mutation\n")
+        rejects(lambda: memory.check_baseline_sources(root, manifest_path, args.manifest_sha256), "dirty tracked baseline source")
+    finally:
+        tracked.write_bytes(original)
+    unallowed = root / "unallowed_full_freeze_check.go"
+    assert not unallowed.exists()
+    try:
+        unallowed.write_text("package unallowed\n")
+        rejects(lambda: memory.check_baseline_sources(root, manifest_path, args.manifest_sha256), "unallowed/missing baseline additions")
+    finally:
+        unallowed.rename(fixture / "unallowed_full_freeze_check.go")
+    replacement = prepared / "overlay/quicksilver_workflow_bench_test.go"
+    original = replacement.read_bytes()
+    try:
+        replacement.write_bytes(original + b"\n// deliberately changed compiled replacement\n")
+        rejects(lambda: memory.load_freeze(prepared, args.freeze_sha256), "wrong/changed source/input/overlay/binary identity")
+    finally:
+        replacement.write_bytes(original)
+    memory.load_freeze(prepared, args.freeze_sha256)
+print("baseline full-freeze guard checks PASS; no benchmark executed")
