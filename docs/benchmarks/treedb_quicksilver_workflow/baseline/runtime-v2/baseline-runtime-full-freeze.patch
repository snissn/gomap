+#!/usr/bin/env python3
+"""Prepare the exact baseline with pinned harness additions; never run it."""
+import argparse
+import json
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / "scripts"))
+import treedb_memory_budget_capture as memory
+
+
+def prepare(args):
+    root, proposal = args.source_root.resolve(), Path(__file__).resolve().parent
+    manifest = json.loads(args.manifest.read_text())
+    memory.check_baseline_sources(root, args.manifest, args.manifest_sha256)
+    memory.require(Path(manifest["external_inputs"]["prepare_baseline.py"]["path"]).resolve() == Path(__file__).resolve(), "wrong executing baseline preparation helper")
+    original_generate = memory.generate
+
+    def generate(source, destination, frame_mib):
+        identity = original_generate(source, destination, frame_mib)
+        overlay = destination / "overlay.json"
+        mapping = json.loads(overlay.read_text())
+        identity["baseline_test_compatibility"] = {}
+        for name in ("TreeDB/quicksilver_workflow_bench_test.go", "TreeDB/memory_budget_bench_test.go"):
+            canonical, replacement = source / name, destination / Path(name).name
+            external = Path(manifest["external_inputs"][name]["path"])
+            memory.require(external.resolve() == (proposal / name).resolve(), "wrong replacement location")
+            replacement.write_bytes(external.read_bytes())
+            mapping["Replace"][str(canonical.resolve())] = str(replacement.resolve())
+            identity["baseline_test_compatibility"][name] = {
+                "canonical_sha256": memory.digest(canonical),
+                "replacement_sha256": memory.digest(replacement),
+            }
+        memory.write_json(overlay, mapping)
+        identity["overlay_sha256"] = memory.digest(overlay)
+        memory.write_json(destination / "identity.json", identity)
+        return identity
+
+    memory.generate = generate
+    memory.prepare(argparse.Namespace(source_root=root, output=args.output,
+        leaf_mib=args.leaf_mib, value_bytes=args.value_bytes, threshold=args.threshold,
+        pilot=False, go=args.go, runtime_head=manifest["runtime_head"],
+        harness_sha256=manifest["canonical_sources"]["TreeDB/memory_budget_bench_test.go"],
+        baseline_manifest=args.manifest, baseline_manifest_sha256=args.manifest_sha256))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, required=True)
+    parser.add_argument("--manifest", type=Path, required=True)
+    parser.add_argument("--manifest-sha256", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--go", type=Path, required=True)
+    parser.add_argument("--leaf-mib", type=int, choices=memory.COHORTS, required=True)
+    parser.add_argument("--value-bytes", type=int, choices=(256, 4096), required=True)
+    parser.add_argument("--threshold", type=int, choices=(1, 1024), required=True)
+    prepare(parser.parse_args())
