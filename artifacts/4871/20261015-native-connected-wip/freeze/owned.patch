+				if e != nil || !bytes.Equal(key, r.Key) || !bytes.Equal(val, r.Value) || flags != r.Flags || r.Flags&FlagPointer != 0 && ptr != r.ValuePtr {
+					t.Fatalf("entry %d: %q %q %+v flags=%x err=%v", i, key, val, ptr, flags, e)
+				}
+			}
+		})
+	}
+}
