+		cache.free[n-1] = nil
+		cache.free = cache.free[:n-1]
 	} else {
-		s = z.applyScratch
-		z.applyScratch = nil
+		s = cache.single
+		cache.single = nil
 	}
-	z.scratchMu.Unlock()
+	cache.mu.Unlock()
 	if s == nil {
 		s = newMergeScratch()
 	}
@@ -1295,18 +1317,19 @@ func (z *Zipper) releaseApplyScratch(s *mergeScratch) {
