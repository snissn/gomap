 func (l *closeLease) Close() { l.budget.bytes -= l.bytes; l.bytes = 0 }
 
+// These distinct concrete types support finite cleanup. closeLease intentionally
+// remains Lease-only for the ordinary-origin compatibility controls.
+type finiteCloseBudget struct {
+	bytes                    uint64
+	resizes, closeAdmissions uint64
+}
+type finiteCloseLease struct {
+	budget *finiteCloseBudget
+	bytes  uint64
+}
+
+var _ retainedalloc.WorkLease = (*finiteCloseLease)(nil)
+
+func (b *finiteCloseBudget) AcquireRetention(n uint64) (retainedalloc.Lease, error) {
+	b.bytes += n
+	return &finiteCloseLease{budget: b, bytes: n}, nil
+}
+func (l *finiteCloseLease) Resize(n uint64) error {
+	l.budget.bytes = l.budget.bytes - l.bytes + n
+	l.bytes = n
+	l.budget.resizes++
+	return nil
+}
+func (l *finiteCloseLease) Close() {
+	l.budget.bytes -= l.bytes
+	l.bytes = 0
+}
+func (l *finiteCloseLease) AdmitRetentionResize(w *iterator.OrdinalScanWork) bool {
+	return w != nil && w.Reserve(1, 2*uint64(unsafe.Sizeof(*l))+2*uint64(unsafe.Sizeof(*l.budget)))
+}
+func (l *finiteCloseLease) ResizeWork(n uint64, w *iterator.OrdinalScanWork) (bool, error) {
+	if w == nil {
+		return false, retainedalloc.ErrWorkRequired
+	}
+	if !l.AdmitRetentionResize(w) {
+		return false, nil
+	}
+	err := l.Resize(n)
+	return err == nil, err
+}
+func (l *finiteCloseLease) AdmitRetentionClose(w *iterator.OrdinalScanWork) bool {
+	if w == nil || !w.Reserve(1, 2*uint64(unsafe.Sizeof(*l))+2*uint64(unsafe.Sizeof(*l.budget))) {
+		return false
+	}
+	l.budget.closeAdmissions++
+	return true
+}
