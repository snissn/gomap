 732142  732141 bash            bash -c timeout 120s python3 - <<'PY' from pathlib import Path import os,json,hashlib,subprocess,time,signal B=Path("/home/mikers/benchmarks/mvcc-4871-repair-20261013") src=B/"evidence/successor-4876-actual-effect-20261014" out=B/"evidence/successor-4876-actual-multilevel-writer-trace-20261015" out.mkdir(exist_ok=False) def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest() def put(n,o): (out/n).write_text(json.dumps(o,indent=2)+"\n") manifest=json.loads((src/"manifest.json").read_bytes()) assert sha(src/"manifest.json")=="23cff07ddab5d40f1f6c9a4b06142b57956228a82983cca2e67f00c8f0a0ffc0" verified=[] for x in manifest["publishable"]:  p=src/x["path"]  assert p.stat().st_size==x["bytes"] and sha(p)==x["sha256"],str(p)  verified.append(x) binary=src/"after.test" assert sha(binary)=="8c54eca1f1740fd7880c65a52b465a20f6425bcd4c55e96fa676310550ef38f4" cmd=next(x for x in json.loads((src/"command-receipts.json").read_bytes()) if x["label"]=="multilevel-forced_pointer-pair1-after") put("input-binding.json",{"manifest_sha256":sha(src/"manifest.json"),"manifest_members_verified":len(verified),"binary_sha256":sha(binary),"binary_bytes":binary.stat().st_size,"harness":[x for x in verified if x["path"].startswith("harness/")],"original_command":cmd}) processes=subprocess.check_output(["ps","-eo","pid,ppid,comm,args"],text=True) (out/"preflight.processes.raw").write_text(processes) foreign=[] for line in processes.splitlines()[1:]:  z=line.split(None,3)  if len(z)<3: continue  c=z[2]  if c in ("go","compile","link","benchstat","unified-bench") or c.endswith(".test"): foreign.append(line) assert not foreign,"competing producer: "+str(foreign) def ticks():  return {s.split()[0]:list(map(int,s.split()[1:])) for s in Path("/proc/stat").read_text().splitlines() if s.split() and s.split()[0] in ("cpu0","cpu1","cpu2","cpu3")} a=ticks();time.sleep(.3);b=ticks();busy={} for k in a:  delta=[y-x for x,y in zip(a[k],b[k])]  busy[k]=1-(delta[3]+delta[4])/sum(delta) put("preflight.json",{"competing_go_producers":foreign,"pinned_cpu_busy_fraction":busy,"loadavg":Path("/proc/loadavg").read_text(),"meminfo":Path("/proc/meminfo").read_text(),"uptime":Path("/proc/uptime").read_text()}) assert sum(busy.values())/4<.2,"host not quiet" argv=cmd["argv"]+["-test.trace="+str(out/"trace.out")] env=os.environ.copy();env.update(cmd["env"]) put("command.json",{"argv":argv,"env":cmd["env"],"cwd":cmd["cwd"],"only_argv_delta":"added -test.trace","go_process_wall_timeout_s":90,"outer_driver_bound_s":120,"existing_test_timeout_unchanged":"120s"}) start=time.monotonic() p=subprocess.Popen(argv,cwd=cmd["cwd"],env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,start_new_session=True) timedout=False try: raw,_=p.communicate(timeout=90) except subprocess.TimeoutExpired:  timedout=True;os.killpg(p.pid,signal.SIGKILL);raw,_=p.communicate(timeout=5) (out/"benchmark.raw").write_bytes(raw) postsha=sha(binary) put("receipt.json",{"exit":p.returncode,"timed_out":timedout,"elapsed_s":time.monotonic()-start,"binary_sha256_before":"8c54eca1f1740fd7880c65a52b465a20f6425bcd4c55e96fa676310550ef38f4","binary_sha256_after":postsha,"binary_unchanged":postsha=="8c54eca1f1740fd7880c65a52b465a20f6425bcd4c55e96fa676310550ef38f4","raw_bytes":len(raw),"raw_sha256":sha(out/"benchmark.raw"),"trace_bytes":(out/"trace.out").stat().st_size if (out/"trace.out").exists() else None,"trace_sha256":sha(out/"trace.out") if (out/"trace.out").exists() else None,"benchmark_invocations":1}) (out/"postrun.processes.raw").write_text(subprocess.check_output(["ps","-eo","pid,ppid,comm,args"],text=True)) print("OUT",out);print((out/"preflight.json").read_text()[:400]);print((out/"receipt.json").read_text());print(raw.decode()[-13000:])  PY
