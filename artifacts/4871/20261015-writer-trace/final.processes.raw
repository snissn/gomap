rics,writer_stall_goid=stall["goid"],writer_stall_syscall="unix.Dup",syscall_interval_ns=stall["duration_ns"],writer_max_index=metrics["writer_max_index"],writer_max_ns=metrics["writer_max_ns"],syscall_fraction_of_writer_max=frac,gc_overlap_count=0,parsed_gc_range_count=145,syscall_return_state="Running",separate_go_runnable_delay_recorded=False,public_gates_passed=True,CommitAt348_dup_intervals=dict(measured64=len(measured),automatic_calibration1=1,measured_sum_ns=sum(r["duration_ns"] for r in measured),over_100us=sum(r["duration_ns"]>=100000 for r in measured)),limitations=["Trace perturbs timing; maximum moved from prior untraced index19 to18.","A syscall interval can include kernel work, waiting or descheduling; trace cannot distinguish them.","This AFTER multilevel trace does not establish GE causality or attribute previously untraced runs.","Longer setup Fsync intervals are not timed CommitAt maxima.","No repeatability, comparative speedup or production acceptance claim."])) manifest=json.loads((src/"manifest.json").read_bytes()) mismatches=[] for x in manifest["publishable"]:  p=src/x["path"]  if p.stat().st_size!=x["bytes"] or sha(p)!=x["sha256"]:mismatches.append(x["path"]) assert not mismatches binary=src/"after.test" assert sha(binary)=="8c54eca1f1740fd7880c65a52b465a20f6425bcd4c55e96fa676310550ef38f4" ps=subprocess.check_output(["ps","-eo","pid,ppid,comm,args"],text=True) (e/"final.processes.raw").write_text(ps) producers=[] for l in ps.splitlines()[1:]:  z=l.split(None,3)  if len(z)>2 and (z[2] in ("go","compile","link","unified-bench") or z[2].endswith(".test")):producers.append(l) put("quiescence.json",dict(time_unix=time.time(),go_quiet=not producers,go_producers=producers,retained_input_manifest_members_checked=len(manifest["publishable"]),retained_input_mismatches=mismatches,binary_sha256=sha(binary),source_mutations=0,builds=0,benchmark_invocations=1,source_ownership="Production source was never written or used for compilation; native and ordinary ownership stays with root/owners.",disposable_release_list=[])) assert not producers report="""# One actual AFTER multilevel pointer writer trace  Exactly one invocation of the retained actual-effect AFTER binary completed with exit0 in1.374seconds. All public value, actual COW/RELAXED selector, ACK, populated PRIMARY layout and explicit Close gates passed. Setup proves depth3 with24,582pointer records and historical GetAt(15) returning timestamp10. CPU0–3 were idle and no competing Go producer was present. Original command/env/64x fixture were retained; only standard -test.trace was added. A90-second process-group wall cap and120-second outer cap left the original test timeout unchanged. No build, reseed change, warmup, source edit, retry or second benchmark invocation occurred.  Writer maximum is7,534,593ns at original loop index18. A7,504,768ns unix.Dup syscall interval accounts for99.60% of that maximum. The complete stack with source paths/lines is retained in complete-capture-callchain.raw. The chain is public Store.CommitAt → CommitGroupAt → SetPointWithMVCCInput → setWithMVCCInput → writeCOWPointAdmittedWithMVCCInput → commandWALPublicBatch.write → Batch.WriteAfterCommandWALAppendWithPreparedRevision → writeRegularLocked → writeCOWPublication → prepared command-WAL append callback → appendAndRegisterPublicCommandWAL → appendRawKVCommandWALOrderedEntryScanWithHintPreparedFinalized → appendCommandWALIntentWithTiming → captureCommandWALExternalDependencies → Manager.CaptureStableExternalRIDFence → stableResourceTokenFromOriginal → stableValueLogResourceToken → NewStableValueLogResourceToken → NewStableProducerResourceTokenForDomain → newStableResourceToken → initializeStableResourceToken → duplicateStableSyncFile → duplicateStableFile → unix.Dup. Timed public benchmark frame is benchmark_test.go:348.  There are exactly64 Dup intervals on the measured64-iteration CommitAt348 goroutine66, plus one on the automatic1-iteration calibration goroutine19. Only one measured Dup exceeds100us; the measured Dup sum is7,514,496ns. The63 other measured Dup intervals sum9,728ns. This is one Dup per measured CommitAt rather than repeated Dup within each call. Full-trace count including setup is1,285. No syscall samples were removed from results.  Goroutine66 returns directly Syscall→Running. No separate Go runnable delay is recorded. All145 GC ranges pair cleanly, with no GC/mark-assist/sweep/stop-the-world range overlapping this interval. Longer whole-trace Fsync intervals belong to setup stacks, not this timed writer maximum. Trace cannot distinguish kernel work, kernel waiting or descheduling inside the syscall interval.  Full traced totals:158875ns/op; loop elapsed10,167,808ns; writer sum8,764,776ns, reader sum1,397,222ns, residual5,810ns. Writer p5014,190ns, reader p5016,840ns;39844B/op and179allocs/op. Timed recorded WAL sync, vlog sync, public checkpoint, rotation/enqueue and new segment/directory-sync deltas remain zero. Timing includes the maximum.  This reproduces the same stable-token Dup latency site on actual AFTER multilevel public path previously seen on BEFORE/small, strengthening attribution of a real writer tail. It does not explain kernel behavior, establish GE causality or attribute the four earlier untraced multilevel calls. Trace timing is diagnostic only and cannot replace the retained +15.89% whole-unit concern or comparative/final gates.  The source seam identified by the stack is original-child conversion in stableResourceTokenFromOriginal/CaptureStableExternalRIDFence and token initialization in rootpublication/resource_token.go. The stack alone does not prove a maintained shared physical-backing reuse API or a safe code change. Any source-only reuse review must preserve exact external-RID membership, stable physical identity, independent retained lifetimes, command-WAL fence ownership, errors and Close/custody semantics. No bypass of Dup, durability change, GC tuning or new resource cache is justified by this trace. No further collection is requested or performed.  The binary, common harness and all85 parent manifest members rehash unchanged. Full10,323,541-byte trace, raw benchmark, original command/env, input binding, long-syscall stacks, all paired GC ranges and both local analysis commands are retained. Parsed output was streamed (6,791,989,801bytes, identical SHA across both analysis passes) rather than persisted; full trace permits reprocessing. Production sources are untouched; Go is quiet. Binaries remain retained at original paths and excluded from publication. No paths released for cleanup. """ (e/"report.md").write_text(report) files=sorted(p for p in e.iterdir() if p.is_file() and p.name!="manifest.json") put("manifest.json",dict(schema="finite-artifact-allowlist-v1",artifact_root=str(e),purpose="one actual AFTER multilevel public pointer trace; attribution only",publishable=[dict(path=p.name,bytes=p.stat().st_size,sha256=sha(p)) for p in files],retained_binary=dict(path=str(binary),bytes=binary.stat().st_size,sha256=sha(binary)),input_source_artifact=dict(root=str(src),manifest_sha256=sha(src/"manifest.json"),durable_artifact_commit="16d1b29593f966ecb9159a1e93e562f115f9f3bb"),excluded_binaries=[str(binary)],source_mutations=0,builds=0,benchmark_invocations=1,disposable_release_list=[])) print(json.dumps(dict(artifact_root=str(e),manifest_sha256=sha(e/"manifest.json"),report_sha256=sha(e/"report.md"),receipt_sha256=sha(e/"receipt.json"),attribution_sha256=sha(e/"attribution.json"),publishable_count=len(files),publishable_bytes=sum(p.stat().st_size for p in files),syscall_fraction=frac,go_quiet=not producers),indent=2))  PY
