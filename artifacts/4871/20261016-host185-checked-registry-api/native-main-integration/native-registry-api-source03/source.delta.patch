 // Ordinary lease failures exercise the real registry refund path, rather than
 // altering a registry receipt or declaring a synthetic generation complete.
-type registryHeaderFailureBudgetV6 struct{ failShrink bool }
+type registryHeaderFailureBudgetV6 struct {
+	mu            sync.Mutex
+	failShrink    bool
+	target        func(old, next uint64) bool
+	beforeFailure func()
+	failures      uint64
+}
+
+func (b *registryHeaderFailureBudgetV6) arm(target func(old, next uint64) bool, beforeFailure func()) {
+	b.mu.Lock()
+	b.failShrink, b.target, b.beforeFailure = true, target, beforeFailure
+	b.mu.Unlock()
+}
+func (b *registryHeaderFailureBudgetV6) disarm() {
+	b.mu.Lock()
+	b.failShrink = false
+	b.mu.Unlock()
+}
+func (b *registryHeaderFailureBudgetV6) failureCount() uint64 {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.failures
+}
+
+// This original scalar query takes only registry.mu, never the governing Owner
+// or its refund receipt. Registry disposal releases registry.mu before Resize.
+func registryHeaderSlowCountV6(r *lifecycle.ReaderRegistry) (uint64, bool) {
+	w := iterator.OrdinalScanWork{RecordLimit: 32, ByteLimit: 1 << 20}
+	g, ready := r.MaintenanceNativeMinimumGeometryForTestV6(&w)
+	return g.FallbackSlots, ready && g.Complete && !g.Dirty
+}
