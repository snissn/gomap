+// ResetCompletedOriginal reuses a surviving parent's ordinary receipt after
+// its exact delta and governing shrink have completed. Failed or unfinished
+// receipts retain their original custody, and bounded work remains with its
+// original caller. The parent must have ended every alias to the disposed child.
+func (s *RemovalWork) ResetCompletedOriginal() (bool, error) {
+	if s == nil {
+		return false, ErrWorkRequired
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.native {
+		return false, ErrWorkRequired
+	}
+	if !s.done {
+		return false, ErrCapacity
+	}
+	s.resetFieldsLocked()
+	return true, nil
+}
