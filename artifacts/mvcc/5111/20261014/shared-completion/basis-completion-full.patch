+	if operations.owner == nil || operations.originalCustody == nil || operations.charge == 0 {
+		t.Fatal("failed original pager operations refunded")
+	}
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	token.Release()
+	if r.calls != 1 {
+		t.Fatal("actual physical failure replayed completion")
+	}
+}
