+		if refreshErr := d.RefreshValueLogSet(); refreshErr != nil {
+			t.Fatal(refreshErr)
+		}
+		if d.snapshotViewRO.Load() == original || original.state.ValueLogSet.RefCount.Load() != 0 {
+			t.Fatal("actual refresh did not retire original Set during admission")
+		}
+		return nil
+	})
