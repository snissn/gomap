{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "treedb-query-under-write/mixed-report-v1",
  "title": "Bounded mixed colocated window envelope",
  "type": "object",
  "required": [
    "Event",
    "Report"
  ],
  "additionalProperties": false,
  "properties": {
    "Event": {
      "enum": [
        "planned",
        "result"
      ]
    },
    "Report": {
      "type": "object",
      "required": [
        "Version",
        "Kind",
        "Verdict",
        "Admission",
        "Anchors",
        "Prefixes",
        "Writes",
        "Retries",
        "Visibility",
        "VisibilityEvidence",
        "Attempts",
        "ReadPrefixes",
        "HighestNewCommitIndex",
        "RequiredAppliedIndex",
        "WriteCounts",
        "RetryCounts",
        "Audits",
        "AuthorityBoundary"
      ],
      "properties": {
        "Version": {
          "const": 1
        },
        "Kind": {
          "const": "fixed_cluster_mixed_window_v1"
        },
        "Verdict": {
          "type": "string"
        },
        "Anchors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "ID",
              "VectorSHA256"
            ]
          }
        },
        "Prefixes": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": [
              "Prefix",
              "PopulationRows",
              "PopulationSHA256",
              "Top10SHA256",
              "Truth",
              "Changed"
            ],
            "description": "All seven full canonical population oracles computed before networking. Default invariant; explicit changing-top10 permits derived membership changes without rewriting exported baseline truth."
          }
        },
        "Writes": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 6
        },
        "Retries": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 2
        },
        "Visibility": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 6
        },
        "VisibilityEvidence": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 6
        },
        "Attempts": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 65600
        },
        "ReadPrefixes": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 65536,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "Ordinal",
              "Lower",
              "Upper",
              "Matched",
              "CompatibleMask",
              "RecallAt10"
            ],
            "properties": {
              "Ordinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "Lower": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "Upper": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "Matched": {
                "type": "integer",
                "minimum": -1,
                "maximum": 6,
                "description": "First compatible witness only; not an inferred exact publication time or favorable recall choice."
              },
              "CompatibleMask": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127,
                "description": "Bit p marks complete response compatibility with prefix p inside final actual call/ACK bounds; zero only on rejected proof."
              },
              "RecallAt10": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Minimum recall among every compatible prefix, using each full canonical oracle."
              }
            }
          }
        },
        "HighestNewCommitIndex": {
          "type": "integer",
          "minimum": 0
        },
        "RequiredAppliedIndex": {
          "type": "integer",
          "minimum": 0
        },
        "AuditPlan": {
          "$ref": "#/$defs/auditPlan"
        },
        "Audits": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "ColocatedAudit": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "Population": {
                    "$ref": "#/$defs/populationProof"
                  }
                }
              }
            }
          }
        },
        "Profile": {
          "const": "changing-top10",
          "description": "Optional explicit profile. Absence preserves invariant baseline admission."
        }
      }
    }
  },
  "$defs": {
    "auditPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Version",
        "RunID",
        "HighestNewCommitIndex",
        "RequiredAppliedIndex",
        "Writes",
        "Final"
      ],
      "properties": {
        "Version": {
          "const": 1
        },
        "RunID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "HighestNewCommitIndex": {
          "type": "integer",
          "minimum": 1
        },
        "RequiredAppliedIndex": {
          "type": "integer",
          "minimum": 1
        },
        "Writes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6
        },
        "Final": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6
        },
        "Population": {
          "$ref": "#/$defs/populationExpectation"
        }
      },
      "$comment": "JSON encoded bytes <=524288. ValidateColocatedAuditPlanV1 additionally checks request/token/scope/ACK/ledger identity. Runtime proves current durable source/live authority. JSON Schema alone does not prove either.",
      "x-maxEncodedBytes": 524288
    },
    "populationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Rows",
        "Dimensions",
        "SHA256",
        "Limits"
      ],
      "properties": {
        "Rows": {
          "type": "integer",
          "minimum": 1
        },
        "Dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "SHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "MaxRows",
            "MaxIDBytes",
            "MaxSourceRecordBytes",
            "MaxTotalBytes",
            "MaxInspected"
          ],
          "properties": {
            "MaxRows": {
              "type": "integer",
              "minimum": 1
            },
            "MaxIDBytes": {
              "type": "integer",
              "minimum": 1
            },
            "MaxSourceRecordBytes": {
              "type": "integer",
              "minimum": 1
            },
            "MaxTotalBytes": {
              "type": "integer",
              "minimum": 1
            },
            "MaxInspected": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "description": "Optional external diagnostics attachment, encoding id-le32-fp32-le-v1. This harness emits only the six known-ID audit; schema compatibility alone is no population proof."
    },
    "populationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Rows",
        "Dimensions",
        "Encoding",
        "SHA256",
        "SourceRecordBytes",
        "AssetBytes",
        "TotalBytes",
        "HashedBytes",
        "Inspected"
      ],
      "properties": {
        "Rows": {
          "type": "integer",
          "minimum": 0
        },
        "Dimensions": {
          "type": "integer",
          "minimum": 0
        },
        "SourceRecordBytes": {
          "type": "integer",
          "minimum": 0
        },
        "AssetBytes": {
          "type": "integer",
          "minimum": 0
        },
        "TotalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "HashedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "Inspected": {
          "type": "integer",
          "minimum": 0
        },
        "Encoding": {
          "const": "id-le32-fp32-le-v1"
        },
        "SHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
